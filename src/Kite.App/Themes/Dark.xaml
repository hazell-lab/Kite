<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- dark colours for the launcher -->
    <SolidColorBrush x:Key="CardBrush" Color="#1B1C23" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#30323D" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F2F6" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A3A6B4" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#6E7180" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2B2B3B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#23242E" />
    <SolidColorBrush x:Key="IconTileBrush" Color="#272935" />
    <SolidColorBrush x:Key="FooterBrush" Color="#16171D" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2C37" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#3A2027" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF9C9C" />
    <SolidColorBrush x:Key="KeyCapBrush" Color="#262833" />
    <SolidColorBrush x:Key="KeyCapBorderBrush" Color="#3A3C48" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#6E7180" />
    <SolidColorBrush x:Key="CaretBrush" Color="#B9AFFF" />
    <Color x:Key="ShadowColor">#000000</Color>
    <SolidColorBrush x:Key="IconGlyphBrush" Color="#C9C2FF" />
</ResourceDictionary>
